# LLVM source-based coverage pipeline (C++): the qualified S-CORE coverage
# tool, successor of @score_tooling//coverage. See tools/coverage/.
bazel_dep(name = "score_coverage", version = "0.4.2", dev_dependency = True)

# lobster is a non-dev bazel_dep of score_tooling; its own git_override is ignored
# by Bazel for non-root modules, so the root module must declare it too.
bazel_dep(name = "lobster", version = "0.0.0", dev_dependency = True)
git_override(
    module_name = "lobster",
    commit = "2792e2daee2cf524fdc7b1545fd3537791ebc36c",
    remote = "https://github.com/bmw-software-engineering/lobster.git",
)

bazel_dep(name = "aspect_rules_lint", version = "2.7.1", dev_dependency = True)
bazel_dep(name = "toolchains_llvm", version = "1.8.0", dev_dependency = True)

bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
bazel_dep(name = "google_benchmark", version = "1.9.5")

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1", dev_dependency = True)

bazel_dep(name = "score_baselibs", version = "0.2.17")
bazel_dep(name = "score_communication", version = "0.6.0")
bazel_dep(name = "score_lifecycle", version = "0.10.0")

# LLVM toolchain — provides @llvm_toolchain//:clang-tidy for the clang-tidy aspect.
llvm = use_extension(
    "@toolchains_llvm//toolchain/extensions:llvm.bzl",
    "llvm",
    dev_dependency = True,
)
llvm.toolchain(
    llvm_version = "19.1.7",
)

# Coverage-only Clang instance (covmap instrumentation for the LLVM coverage
# pipeline from @score_coverage; active only under --config=llvm_cov).
# Separate from the 19.1.7 instance above so clang-tidy behavior is untouched.
llvm.toolchain(
    name = "llvm_toolchain_coverage",
    cxx_standard = {"": "c++17"},
    extra_known_features = [
        "@score_coverage//:enable_llvm_coverage_for_death_tests",
    ],
    llvm_version = "22.1.7",
    stdlib = {"": "stdc++"},
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_coverage", "llvm_toolchain_coverage_llvm")

# grpc-java@1.66.0 has a BCR bug (extension no longer generates
# com_envoyproxy_protoc_gen_validate). Pulled transitively via
# score_baselibs, score_lifecycle and score_tooling.
# Override to a fixed version.
single_version_override(
    module_name = "grpc-java",
    version = "1.78.0.bcr.1",
)

# TODO: remove once inherited properly from `score_logging`.
bazel_dep(name = "trlc", version = "0.0.0", dev_dependency = True)
git_override(
    module_name = "trlc",
    commit = "8f369f1208598c2e75f44a77a98d244634ed482a",
    remote = "https://github.com/bmw-software-engineering/trlc.git",
)

