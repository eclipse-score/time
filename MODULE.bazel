## Static analysis — CodeQL (tooling from score_tools, see tools/codeql/)

# Pinned to a commit: the //codeql package is not released yet, so there is no
# version to pin. The commit is the `feat/codeql-static-analysis` branch of the
# etas-contrib fork. Replace this with a released
# bazel_dep(name = "score_tools", version = "<release>") and refresh
# MODULE.bazel.lock once a release contains //codeql.
#
# For local development against a checkout of score_tools:
#   bazel build --override_module=score_tools=../score_tools //tools/codeql:sca_linux
bazel_dep(name = "score_tools", version = "0.0.0", dev_dependency = True)
git_override(
    module_name = "score_tools",
    commit = "3d8f1663b0b026fb623ca93ccd86f46f30367bcf",
    remote = "https://github.com/etas-contrib/score_tools.git",
)

## Integration Test Framework dependencies

bazel_dep(name = "score_itf", version = "0.7.0")

bazel_dep(name = "bazel_skylib", version = "1.9.0", dev_dependency = True)

bazel_dep(name = "rules_pkg", version = "1.2.0")

bazel_dep(name = "rules_oci", version = "2.3.0", dev_dependency = True)

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci", dev_dependency = True)
oci.pull(
    name = "ubuntu_24_04",
    digest = "sha256:2e863c44b718727c860746568e1d54afd13b2fa71b160f5cd9058fc436217b30",
    image = "ubuntu",
    platforms = ["linux/amd64"],
    tag = "24.04",
)
use_repo(oci, "ubuntu_24_04", "ubuntu_24_04_linux_amd64")

bazel_dep(name = "score_rules_imagefs", version = "0.1.0", dev_dependency = True)

imagefs = use_extension("@score_rules_imagefs//extensions:imagefs.bzl", "imagefs", dev_dependency = True)
imagefs.toolchain(
    name = "score_qnx_x86_64_ifs_toolchain",
    sdp_to_import = "@score_qcc_x86_64_toolchain_pkg",
    # imagefs extension does not remap 8.0.4 -> 8.0.0 for platform constraints,
    # so use "8.0.0" here to match the only available sdp_version constraint
    # value in @score_bazel_platforms. The actual SDP binary version comes
    # from sdp_to_import (8.0.4).
    sdp_version = "8.0.0",
    target_cpu = "x86_64",
    target_os = "qnx",
    type = "ifs",
)
use_repo(imagefs, "score_qnx_x86_64_ifs_toolchain")

