{"current_version": "0.1", "project": "S-CORE Time", "project_url": "https://eclipse-score.github.io/time", "versions": {"0.1": {"creator": {"program": "sphinx_needs", "version": "8.0.0"}, "needs": {"comp_req__time__hirs_clock_snapshot": {"content": "``HighResSteadyClock::Now`` shall return a monotonic\n``ClockSnapshot`` without requiring prior initialization, and shall\nnot expose ``Init`` / ``IsAvailable`` / ``WaitUntilAvailable`` on the\nfacade (using them is a compile error).", "docname": "features/time/component_requirements", "external_css": "external_link", "id": "comp_req__time__hirs_clock_snapshot", "lineno": 29, "reqtype": "Functional", "safety": "QM", "satisfies": ["feat_req__time__unified_clock_facade"], "section_name": "Component Requirements", "sections": ["Component Requirements"], "security": "NO", "status": "valid", "title": "HighResSteadyClock always-ready snapshot", "type": "comp_req", "type_name": "Component Requirement"}, "comp_req__time__steady_clock_snapshot": {"content": "``SteadyClock::Now`` shall return a snapshot backed by\n``std::chrono::steady_clock`` without requiring initialization.", "docname": "features/time/component_requirements", "external_css": "external_link", "id": "comp_req__time__steady_clock_snapshot", "lineno": 42, "reqtype": "Functional", "safety": "QM", "satisfies": ["feat_req__time__unified_clock_facade"], "section_name": "Component Requirements", "sections": ["Component Requirements"], "security": "NO", "status": "valid", "title": "SteadyClock always-ready snapshot", "type": "comp_req", "type_name": "Component Requirement"}, "comp_req__time__system_clock_snapshot": {"content": "``SystemClock::Now`` shall return a snapshot backed by\n``std::chrono::system_clock`` without requiring initialization.", "docname": "features/time/component_requirements", "external_css": "external_link", "id": "comp_req__time__system_clock_snapshot", "lineno": 53, "reqtype": "Functional", "safety": "QM", "satisfies": ["feat_req__time__unified_clock_facade"], "section_name": "Component Requirements", "sections": ["Component Requirements"], "security": "NO", "status": "valid", "title": "SystemClock always-ready snapshot", "type": "comp_req", "type_name": "Component Requirement"}, "comp_req__time__vehicle_clock_lifecycle": {"content": "``VehicleClock`` shall provide ``Init``, ``IsAvailable`` and\n``WaitUntilAvailable`` operations that delegate to the backend and\nreport backend init failure and availability-wait timeouts to the\ncaller without blocking indefinitely.", "docname": "features/time/component_requirements", "external_css": "external_link", "id": "comp_req__time__vehicle_clock_lifecycle", "lineno": 16, "reqtype": "Functional", "safety": "QM", "satisfies": ["feat_req__time__explicit_lifecycle"], "section_name": "Component Requirements", "sections": ["Component Requirements"], "security": "NO", "source_code_link": "https://github.com/etas-contrib/score_time/blob/178cb28a11379e208ec4e38c00be1de807a81287/score/time/vehicle_time/src/vehicle_clock.cpp#L50<>score/time/vehicle_time/src/vehicle_clock.cpp:50, https://github.com/etas-contrib/score_time/blob/178cb28a11379e208ec4e38c00be1de807a81287/score/time/vehicle_time/src/vehicle_clock.cpp#L56<>score/time/vehicle_time/src/vehicle_clock.cpp:56, https://github.com/etas-contrib/score_time/blob/178cb28a11379e208ec4e38c00be1de807a81287/score/time/vehicle_time/src/vehicle_clock.cpp#L62<>score/time/vehicle_time/src/vehicle_clock.cpp:62", "status": "valid", "title": "VehicleClock lifecycle operations", "type": "comp_req", "type_name": "Component Requirement"}, "comp_req__time__vehicle_clock_snapshot": {"content": "``VehicleClock::Now`` shall return a ``ClockSnapshot`` whose timepoint\nand ``VehicleTimeStatus`` originate from the same backend read, so\ndownstream callers observe consistent time and status values.", "docname": "features/time/component_requirements", "external_css": "external_link", "id": "comp_req__time__vehicle_clock_snapshot", "lineno": 4, "reqtype": "Functional", "safety": "QM", "satisfies": ["feat_req__time__snapshot_with_status"], "section_name": "Component Requirements", "sections": ["Component Requirements"], "security": "NO", "source_code_link": "https://github.com/etas-contrib/score_time/blob/178cb28a11379e208ec4e38c00be1de807a81287/score/time/vehicle_time/src/vehicle_clock.cpp#L44<>score/time/vehicle_time/src/vehicle_clock.cpp:44", "status": "valid", "title": "VehicleClock returns snapshot with status", "type": "comp_req", "type_name": "Component Requirement"}, "feat_req__time__explicit_lifecycle": {"content": "Clock domains that depend on an external resource (currently\n``VehicleTime``) shall provide ``Init``, ``IsAvailable`` and\n``WaitUntilAvailable`` operations, and shall keep those operations\nunavailable \u2014 at compile time \u2014 on clock domains that are always\nready.", "docname": "features/time/feature_requirements", "external_css": "external_link", "id": "feat_req__time__explicit_lifecycle", "lineno": 32, "reqtype": "Functional", "safety": "QM", "satisfies_back": ["comp_req__time__vehicle_clock_lifecycle"], "section_name": "Feature Requirements", "sections": ["Feature Requirements"], "security": "NO", "status": "valid", "title": "Explicit lifecycle for backends that need it", "type": "feat_req", "type_name": "Feature Requirement"}, "feat_req__time__snapshot_with_status": {"content": "Every ``Clock<Tag>::Now`` call shall return a single immutable\n``ClockSnapshot`` value that bundles the timepoint with the domain's\nstatus metadata, so callers can inspect synchronization quality\nwithout a separate status call.", "docname": "features/time/feature_requirements", "external_css": "external_link", "id": "feat_req__time__snapshot_with_status", "lineno": 19, "reqtype": "Functional", "safety": "QM", "satisfies_back": ["comp_req__time__vehicle_clock_snapshot"], "section_name": "Feature Requirements", "sections": ["Feature Requirements"], "security": "NO", "status": "valid", "title": "Immutable 