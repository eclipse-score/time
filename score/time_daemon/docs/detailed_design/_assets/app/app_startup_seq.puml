@startuml app_startup_seq_diagram

title Application: Startup

hide footbox

autonumber "<font color=red><b>[00]"

legend top left
    |= Color        |= Description           |
    |<#LightCyan>   | Application objects     |
    |<#LightGreen>  | Middleware components   |
endlegend

participant "LifecycleManager" as lcm #LightGreen
participant "TimeDaemon" as vtd_app #LightCyan
participant "TimebaseHandler" as tb_handler #LightCyan
participant "JobRunner thread" as runner #LightCyan

lcm -> vtd_app : Run(parent_token)
activate vtd_app

loop handlers in list order
    vtd_app -> tb_handler : Start(parent_token)
    activate tb_handler
    tb_handler -> runner : Start(parent_token)
    activate runner
    runner --> tb_handler : worker launched
    deactivate runner
    tb_handler --> vtd_app
    deactivate tb_handler
end

note over vtd_app : Run() continues with starting

@enduml
