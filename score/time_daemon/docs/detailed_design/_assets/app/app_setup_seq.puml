@startuml app_setup_seq_diagram

title Application: Setup

hide footbox

autonumber "<font color=red><b>[00]"

legend top left
    |= Color        |= Description            |
    |<#LightCyan>   | Application objects     |
    |<#Wheat>       | Handler machines        |
    |<#LightGreen>  | Middleware components   |
endlegend

participant "LifecycleManager" as lcm #LightGreen
participant "TimeDaemon" as vtd_app #LightCyan
participant "TimebaseHandler" as tb_handler #LightCyan
participant "Machines" as machines #Wheat

lcm -> vtd_app : Initialize(context)
activate vtd_app
loop handlers in list order
    vtd_app -> tb_handler : Initialize()
    activate tb_handler
    tb_handler -> tb_handler : CreateComponents()
    activate tb_handler
    tb_handler -> machines ** : create producers / consumers
    machines --> tb_handler : machine
    tb_handler -> tb_handler : Add(machine, init_timeout)
    tb_handler -> tb_handler : Subscribe(consumer, topic)
    tb_handler -> tb_handler : Publish(producer, topic)
    deactivate tb_handler
    tb_handler --> vtd_app
    deactivate tb_handler
end
vtd_app --> lcm : EXIT_SUCCESS (valid handler list)
deactivate vtd_app

@enduml
