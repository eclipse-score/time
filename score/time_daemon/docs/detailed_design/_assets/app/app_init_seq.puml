@startuml app_init_seq_diagram

title Application: Initialization Sequence

hide footbox

autonumber "<font color=red><b>[00]"

legend top left
    |= Color        |= Description           |
    |<#LightCyan>   | TimeDaemon members     |
    |<#LightGreen>  | Middleware components  |
    |<#Beige>       | SW components          |
endlegend

participant "LifecycleManager" as lcm #LightGreen
participant "TimeDaemon" as td_app #LightCyan
participant "Linked handler factory\n(default: S-CORE)" as factory #LightCyan
participant "GenericTimebaseHandler<T>\n(default: ScoreVehicleTimebaseHandler)" as tb_handler #LightCyan
participant "Components" as components #Beige
participant "JobRunner" as runner #LightCyan

== TimeDaemon Construction ==

lcm -> td_app ** : Construct TimeDaemon()
activate td_app
td_app -> factory : CreateTimebaseHandlers()
activate factory
factory -> tb_handler ** : create handler (default: via CreateVehicleTimebase())
activate tb_handler

tb_handler -> tb_handler : create MessageBroker<T>

tb_handler --> factory : unique_ptr<TimebaseHandler>
deactivate tb_handler
factory --> td_app : vector<unique_ptr<TimebaseHandler>>
deactivate factory
td_app --> lcm : TimeDaemon instance
deactivate td_app

== Setup Phase ==

lcm -> td_app : Initialize(context)
activate td_app
td_app -> td_app : validate entire handler list

alt empty list or null handler
    td_app --> lcm : EXIT_FAILURE (no handlers initialized)
else valid composition
    loop handlers in list order
        td_app -> tb_handler : Initialize()
        activate tb_handler

        tb_handler -> tb_handler : CreateComponents()
        tb_handler -> components ** : create and Add() machines with timeouts
        tb_handler -> tb_handler : Publish() / Subscribe() topic wiring
        tb_handler -> runner ** : JobRunner(initialization jobs)
        tb_handler -> tb_handler : is_configured_ = true\nstatus remains kIdle

        tb_handler --> td_app : setup complete
        deactivate tb_handler
    end

    td_app --> lcm : EXIT_SUCCESS
end
deactivate td_app

@enduml
