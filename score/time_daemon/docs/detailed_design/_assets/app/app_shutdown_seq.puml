@startuml app_shutdown_seq_diagram

title Application: Shutdown

hide footbox

autonumber "<font color=red><b>[00]"

legend top left
    |= Color        |= Description           |
    |<#LightCyan>   | Application objects     |
    |<#Wheat>       | Handler machines        |
    |<#LightGreen>  | Middleware components   |
endlegend

participant "LifecycleManager" as lcm #LightGreen
participant "TimeDaemon" as vtd_app #LightCyan
participant "TimebaseHandler" as tb_handler #LightCyan
participant "Machines" as machines #Wheat

activate vtd_app

loop handlers in reverse list order
    vtd_app -> tb_handler : Stop()
    activate tb_handler
    loop all proactive machines in reverse registration order
        tb_handler -> machines : Stop()
        activate machines
        machines --> tb_handler
        deactivate machines
    end
    tb_handler --> vtd_app
    deactivate tb_handler
end
vtd_app --> lcm : EXIT_SUCCESS (handlers stopped)
deactivate vtd_app

@enduml
